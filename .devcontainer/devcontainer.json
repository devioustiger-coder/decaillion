{
  "name": "DECAILLION",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm run prepare:vendor && npm test",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "DECAILLION playable preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup node scripts/serve.cjs >/tmp/decaillion.log 2>&1 &"
}
